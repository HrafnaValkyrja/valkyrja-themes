{
  "manifest_version": 3,
  "name": "Valkyrja Themes",
  "version": "0.1.4",
  "description": "Turns every website into a dark theme of your choice: Nott, Valkyrja Night and nine more.",
  "browser_specific_settings": {
    "gecko": {
      "id": "valkyrja-themes@hrafnavalkyrja.github.io",
      "update_url": "https://raw.githubusercontent.com/HrafnaValkyrja/valkyrja-themes/main/updates.json",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "theme",
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "proxy.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN",
      "match_origin_as_fallback": true
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_origin_as_fallback": true
    }
  ],
  "action": {
    "default_title": "Valkyrja Themes",
    "default_popup": "popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/*.ttf"
      ],
      "matches": [
        "https://claude.ai/*",
        "https://github.com/*",
        "https://*.github.com/*",
        "https://www.google.com/*"
      ]
    }
  ]
}
